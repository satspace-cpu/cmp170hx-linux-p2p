                               &params0,
                               sizeof(NV2080_CTRL_CMD_INTERNAL_BUS_SETUP_P2P_MAILBOX_LOCAL_PARAMS));
+    NV_PRINTF(LEVEL_ERROR,
+              "CMPUNLOCK_MBOX: SETUP_LOCAL gpu=%d l2r=%u r2l=%u status=0x%x "
+              "localP2PDomRemoteAddr=0x%llx remoteP2PDomLocalAddr=0x%llx "
+              "remoteWMBoxLocalAddr=0x%llx war999673=%u\n",
+              pGpu0->gpuInstance, local2Remote, remote2Local, status,
+              (NvU64)localP2PDomainRemoteAddr, (NvU64)remoteP2PDomainLocalAddr,
+              (NvU64)remoteWMBoxLocalAddr, (NvU32)bNeedWarBug999673);
     NV_ASSERT(status == NV_OK);
 
     // Setup PCIE P2P Mailbox on remote GPU
@@ -143,8 +150,29 @@
                               NV2080_CTRL_CMD_INTERNAL_BUS_SETUP_P2P_MAILBOX_REMOTE,
                               &params1,
                               sizeof(NV2080_CTRL_CMD_INTERNAL_BUS_SETUP_P2P_MAILBOX_REMOTE_PARAMS));
+    NV_PRINTF(LEVEL_ERROR,
+              "CMPUNLOCK_MBOX: SETUP_REMOTE gpu=%d l2r=%u r2l=%u status=0x%x "
+              "remoteWMBoxAddrU64=0x%llx wmboxBar1Addr=0x%llx\n",
+              pGpu1->gpuInstance, local2Remote, remote2Local, status,
+              (NvU64)remoteWMBoxAddrU64,
+              (NvU64)pKernelBus1->p2pPcie.writeMailboxBar1Addr);
     NV_ASSERT(status == NV_OK);
 
+    /*
+     * Read the mailbox routing registers back. If GSP actually programmed the
+     * mailbox these are non-zero for the configured peer; all-zero means the
+     * request was accepted and silently dropped.
+     */
+    NV_PRINTF(LEVEL_ERROR,
+              "CMPUNLOCK_MBOX: readback gpu0=%d WREQMB[%u] L=0x%08x H=0x%08x | "
+              "gpu1=%d WREQMB[%u] L=0x%08x H=0x%08x\n",
+              pGpu0->gpuInstance, local2Remote,
+              GPU_REG_RD32(pGpu0, NV_P2P_WREQMB_L(local2Remote)),
+              GPU_REG_RD32(pGpu0, NV_P2P_WREQMB_H(local2Remote)),
+              pGpu1->gpuInstance, remote2Local,
+              GPU_REG_RD32(pGpu1, NV_P2P_WREQMB_L(remote2Local)),
+              GPU_REG_RD32(pGpu1, NV_P2P_WREQMB_H(remote2Local)));
+
     kbusWriteP2PWmbTag_HAL(pGpu1, pKernelBus1, remote2Local, params0.p2pWmbTag);
 }
 
